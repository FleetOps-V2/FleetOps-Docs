        <mxCell id="iam" value="IAM + IRSA Roles&#xa;App / ESO / ALB Ctrl&#xa;Autoscaler / GitHub OIDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;fontColor=#ffffff;strokeColor=#DD344C;fontStyle=1;fontSize=11;" vertex="1" parent="1">

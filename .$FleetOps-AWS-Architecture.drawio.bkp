        <mxCell id="ei1" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#326CE5;strokeWidth=1;dashed=1;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="ingress" target="pod_frontend" parent="1">

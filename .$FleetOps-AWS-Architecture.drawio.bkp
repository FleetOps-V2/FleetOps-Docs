        <!-- Integration -->
        <mxCell id="step_fn" value="AWS Step Functions&#xa;Service Request&#xa;State Machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="745" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sns" value="Amazon SNS&#xa;Insurance Alerts&#xa;Service Overdue Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1880" y="745" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="eventbridge" value="Amazon EventBridge&#xa;Daily maintenance&#xa;scan trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="850" width="190" height="75" as="geometry" />
        </mxCell>

        <!-- Storage -->
        <mxCell id="s3" value="Amazon S3&#xa;Vehicle Documents&#xa;Terraform State" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;fontColor=#ffffff;strokeColor=#3F8624;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1880" y="850" width="190" height="75" as="geometry" />
        </mxCell>

        <!-- Audit -->
        <mxCell id="cloudtrail" value="AWS CloudTrail&#xa;API audit logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="955" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="config_aws" value="AWS Config&#xa;Compliance rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1880" y="955" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="vpc_flow" value="VPC Flow Logs&#xa;CloudWatch Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1050" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="eks_logs" value="EKS Control Plane Logs&#xa;CloudWatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;fontColor=#ffffff;strokeColor=#E7157B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1880" y="1050" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dynamodb" value="DynamoDB&#xa;Terraform State Lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E73B8;fontColor=#ffffff;strokeColor=#2E73B8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1145" width="190" height="65" as="geometry" />
        </mxCell>

        <!-- ===== CONNECTIONS ===== -->

        <!-- User → Route53 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;" edge="1" source="user" target="route53" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Route53 → CloudFront -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="route53" target="cloudfront" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WAF → CloudFront (WAF is a web ACL ASSOCIATED with CloudFront — not a downstream hop) -->
        <mxCell id="e3" value="web ACL protects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;endArrow=open;endFill=0;" edge="1" source="waf" target="cloudfront" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ACM → CloudFront (TLS certificate attached to CloudFront distribution) -->
        <mxCell id="e_acm" value="TLS cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;endArrow=open;endFill=0;" edge="1" source="acm" target="cloudfront" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CloudFront → IGW (origin traffic enters VPC via IGW) -->
        <mxCell id="e4" value="origin.fleetops.website" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cloudfront" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IGW → ALB (traffic forwarded to load balancer in public subnet) -->
        <mxCell id="e4b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="igw" target="alb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB → Ingress: exit ALB bottom → go down left side corridor → turn right into Ingress left -->
        <!-- Avoids routing through ArgoCD/ESO boxes which sit at the same y level as ALB center -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="alb" target="ingress" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1092" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ArgoCD → Namespace (sync) -->
        <mxCell id="e6" value="GitOps sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;" edge="1" source="argocd" target="ns" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ESO → K8s Secrets (straight down into namespace) -->
        <mxCell id="e7" value="injects secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="eso" target="k8s_secrets" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vehicle Svc → RDS (exit right, enter left) -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E73B8;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="pod_vehicle" target="rds" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="877" />
              <mxPoint x="1250" y="509" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Vehicle Svc → Redis (exit right, enter left) -->

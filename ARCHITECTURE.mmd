flowchart TB
    USER(["👤 Users / Internet"])

    subgraph EDGE["LAYER 1 — DNS · CDN · EDGE"]
        R53["Route53\nfleetops.website\nA alias record"]
        CF["CloudFront + WAFv2\nAWS Managed Rules\nOrigin: origin.fleetops.website\nACM wildcard cert\nLogs → S3 cf-logs"]
        ALB["Application Load Balancer\nShared · tag: fleetops\nHTTPS:443 · HTTP:80 → redirect\nTarget-type: ip"]
    end

    subgraph VPC["VPC 10.2.0.0/16 · us-east-1"]
        NAT["NAT Gateway\nus-east-1a only"]

        subgraph EKS["Amazon EKS 1.31 · Node: m7i-flex.large · min:2 max:5 desired:2"]
            subgraph PROD["Namespace: fleetops-prod  |  SA: fleetops-app  →  IRSA: fleetops-prod-app-irsa-role"]
                AUTH["auth-service\n2 replicas · 100m/500m\n/api/auth · /api/audit\nJWT HS256 · BCrypt-10 · Redis blacklist"]
                VEHICLE["vehicle-service\n2 replicas · 100m/500m\n/api/vehicles · /api/tracking\nBedrock · Redis @Cacheable · S3 presign"]
                MAINT["maintenance-service\n2 replicas · 100m/500m\n/api/tasks · /api/media\nEFS mount · SNS manual broadcast"]
                REQUEST["request-service\n2 replicas · 100m/500m\n/api/requests\nStep Functions StartExecution"]
                FRONTEND["frontend / nginx\n2 replicas · 100m/250m\n/ — React 18 SPA\ntry_files → index.html"]
            end
            subgraph ARGOCD_NS["Namespace: argocd"]
                ARGOCD["ArgoCD · App-of-Apps\ngithub.com/FleetOps-V2/fleetops-deployments\nautoSync · selfHeal · prune · syncWaves 0-5"]
            end
            subgraph ESO_NS["Namespace: external-secrets"]
                ESO["External Secrets Operator\nClusterSecretStore\nRefresh interval: 1h\nIRSA credentials"]
            end
            FLUENT["Fluent Bit DaemonSet\n/var/log/containers/* → CloudWatch"]
        end

        subgraph DBSUBNETS["DB Subnets · 10.2.20.0/24 · 10.2.21.0/24 · No internet route"]
            RDS[("RDS PostgreSQL 15.7\ndb.t3.micro · 20 GB gp2\nSingle-AZ · us-east-1\nKMS encrypted · No public access\nFlyway migrations on startup")]
            REDIS[("ElastiCache Redis 7\ncache.t3.micro · Single-node\nvehicles cache: 5 min TTL\nfleetAnalysis cache: 15 min TTL\nNoOpCacheManager fallback")]
        end
    end

    subgraph STORAGE["LAYER 4 — DATA · STORAGE"]
        S3_DOCS["S3: fleetops-prod-vehicle-docs\nKMS encrypted · Versioned\nCORS enabled · Lifecycle rules\nPresigned PUT — browser uploads direct"]
        EFS_FS["EFS: fleetops-prod\nKMS encrypted · ReadWriteMany\nCSI driver mount\nTargets in us-east-1a and us-east-1b\nUsed by maintenance-service"]
    end

    subgraph SERVERLESS["LAYER 5 — EVENTS · SERVERLESS"]
        EB["EventBridge\nRule: rate(1 day)\ndaily-maintenance-scan"]
        LAMBDA["Lambda: alert-processor\nNode.js 22.x · Non-VPC\nX-Ray enabled\nJWT cache across warm invocations"]
        SFN["Step Functions\nrequest-workflow\n6 Pass states: Open→PendingApproval\n→Approved→Assigned→InProgress→Completed\nALL logging · X-Ray · KMS"]
        BEDROCK["Amazon Bedrock\namazon.nova-lite-v1:0\nConverse API · maxTokens: 2500\nSTS AssumeRole from IRSA"]
        SNS_INS["SNS: insurance-alerts\nKMS encrypted\nEmail subscriptions"]
        SNS_SVC["SNS: service-alerts\nKMS encrypted\nEmail subscriptions"]
        EMAIL(["📧 Email Subscribers\nalert_emails list"])
    end

    subgraph SECURITY["LAYER 6 — SECURITY · SECRETS · IAM"]
        SM["Secrets Manager\nfleetops/prod/db\nfleetops/prod/jwt\nfleetops/prod/redis\nfleetops/prod/bedrock/credentials\nfleetops/prod/lambda-service-credentials\nKMS encrypted"]
        SSM["SSM Parameter Store\n/fleetops/prod/redis/endpoint\n/fleetops/prod/cors-origins\n/fleetops/prod/sns/insurance-alerts-arn\n/fleetops/prod/sns/service-alerts-arn"]
        KMS["KMS · 5 CMKs\nrds-key · secrets-key\ns3-key · efs-key · events-key\nAll data encrypted at rest"]
    end

    subgraph OBS["LAYER 7 — OBSERVABILITY · COMPLIANCE"]
        CW["CloudWatch\nDashboards: RDS · CPU · DB conns\nAlarms → SNS service-alerts\nLog Groups: /fleetops/*\n365-day retention · KMS encrypted"]
        CT["CloudTrail\nS3 encrypted · Versioned\nAll API calls logged"]
        CFG["AWS Config\nCompliance monitoring\nSecurity drift detection"]
        XRAY["AWS X-Ray\nDistributed tracing\nLambda + Step Functions"]
    end

    subgraph CICD["LAYER 8 — CI/CD · GITOPS"]
        GH["GitHub Repositories\nfleetops-auth-service\nfleetops-vehicle-service\nfleetops-maintenance-service\nfleetops-request-service\nfleetops-frontend\nfleetops-deployments\nfleetops-terraform"]
        GHA["GitHub Actions · OIDC → AWS\n3 Workflows:\njava-ci-ecr.yml — build + scan + push\ncd-ec.yml — update deploy repo\nterraform-apply.yml — plan + apply"]
        ECR["Amazon ECR\nfleetops-dev/*\nfleetops-prod/*\nLifecycle policies\nTrivy + Snyk + SonarQube gates"]
        TFSTATE["S3: fleetops-terraform-state-johan\nkey: environments/prod/terraform.tfstate\nVersioned · Encrypted"]
        DDB[("DynamoDB\nfleetops-terraform-locks\nTerraform state lock")]
    end

    %% ─── User Traffic ───────────────────────────────────────────────
    USER -->|HTTPS| R53
    R53 -->|A alias record| CF
    CF -->|"Host: origin.fleetops.website"| ALB

    %% ─── ALB Routing ────────────────────────────────────────────────
    ALB -->|"/"| FRONTEND
    ALB -->|"/api/auth  /api/audit"| AUTH
    ALB -->|"/api/vehicles  /api/tracking"| VEHICLE
    ALB -->|"/api/tasks  /api/media"| MAINT
    ALB -->|"/api/requests"| REQUEST
    ALB -->|"argocd.fleetops.website"| ARGOCD

    %% ─── App → Data ─────────────────────────────────────────────────
    AUTH -->|JDBC / HikariCP| RDS
    VEHICLE -->|JDBC / HikariCP| RDS
    MAINT -->|JDBC / HikariCP| RDS
    REQUEST -->|JDBC / HikariCP| RDS
    VEHICLE -->|"@Cacheable fleetAnalysis 15min"| REDIS
    AUTH -->|JWT blacklist entries| REDIS
    VEHICLE -->|presigned PUT URL| S3_DOCS
    MAINT -->|CSI mount /var/www/fleetops/shared-media| EFS_FS

    %% ─── Serverless Flows ───────────────────────────────────────────
    REQUEST -->|StartExecution| SFN
    VEHICLE -->|Converse API + STS AssumeRole| BEDROCK

        <!-- ===== CONNECTIONS ===== -->

        <!-- User → CloudFront -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" source="user" target="cf" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CloudFront → ALB -->
        <mxCell id="e2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="cf" target="alb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB → Frontend -->
        <mxCell id="e3" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#326CE5;strokeWidth=2;" edge="1" source="alb" target="nginx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB → Auth Service -->
        <mxCell id="e4" value="/api/auth/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ED7100;strokeWidth=2;" edge="1" source="alb" target="auth_svc" parent="1">
          <mxGeometry relative="1" as="geometry" />

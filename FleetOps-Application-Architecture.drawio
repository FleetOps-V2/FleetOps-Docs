        <!-- ALB → Vehicle Service -->
        <mxCell id="e5" value="/api/vehicles/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ED7100;strokeWidth=2;" edge="1" source="alb" target="vehicle_svc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB → Maintenance Service -->
        <mxCell id="e6" value="/api/maintenance/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ED7100;strokeWidth=2;" edge="1" source="alb" target="maint_svc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB → Request Service -->

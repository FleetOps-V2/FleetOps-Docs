        <!-- ===== EKS CLUSTER BOX ===== -->
        <mxCell id="eks_box" value="Amazon EKS — Namespace: fleetops-prod" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1120" height="830" as="geometry" />
